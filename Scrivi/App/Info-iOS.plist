<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The iOS target generates its Info.plist; Xcode merges this file into it. [SP-206] Without this declaration
	     `UTType("com.caposoft.scrivi.archive")` is nil on iOS and the import picker greys every .scrivarchive out.
	     Kept identical to the Mac's entries in Info.plist. -->
	<!-- [SP-224] Files lists Scrivi under Open With, and a tap opens the package where it lies (in place, never a copy).
	     The roles and ranks are the Mac's (Info.plist): a world is Viewer/Alternate, reached only through a project. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>com.caposoft.scrivi.project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.caposoft.scrivi.project</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>com.caposoft.scrivi.world</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.caposoft.scrivi.world</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>com.caposoft.scrivi.archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.caposoft.scrivi.archive</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.caposoft.scrivi.project</string>
			<key>UTTypeDescription</key>
			<string>Scrivi Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>scrivi</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.caposoft.scrivi.world</string>
			<key>UTTypeDescription</key>
			<string>Scrivi World</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>scrivworld</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.caposoft.scrivi.archive</string>
			<key>UTTypeDescription</key>
			<string>Scrivi Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>scrivarchive</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
